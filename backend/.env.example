# Copiar como .env y ajustar.

# SQLite (sin instalar nada, ideal para la demo):
DATABASE_URL=sqlite:///./turnofacil.db
# MySQL 8 (producción):
# DATABASE_URL=mysql+pymysql://turnofacil:turnofacil@localhost:3306/turnofacil

# Clave para firmar los tokens JWT (mínimo 32 caracteres). Cambiarla en producción.
JWT_SECRET=cambiar-esta-clave-por-una-larga-y-secreta-1234
JWT_HORAS=10

# Origen del frontend en desarrollo (Vite).
CORS_ORIGINS=http://localhost:5173

# Minutos estimados por persona para calcular la espera en el kiosco.
MINUTOS_POR_PERSONA=3
